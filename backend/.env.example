# ── PowerSmart Kenya — Backend environment reference ──────────────────────
# Copy to `.env` in the backend directory and fill in real values.
# NEVER commit the real .env file.

# App environment: "development" (default) | "production"
# In production the server refuses to start without a strong JWT_SECRET.
APP_ENV=development

# Port the API listens on
PORT=8080

# JWT signing secret — MUST be set and at least 32 characters in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET= 3e6c8835e88a0ac5302c26e0597f85b4124985faee18f45a401deeb8a689090f


# Database driver + DSN (SQLite by default)
DB_DRIVER=sqlite
DB_DSN=./powersmart.db

# Comma-separated list of allowed browser origins.
# Leave empty in development (wildcard). REQUIRED in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://powersmart.co.ke,https://app.powersmart.co.ke
CORS_ALLOWED_ORIGINS=

# Optional: directory that holds the frontend files (defaults to ./frontend)
FRONTEND_DIR=

# ── Administrator account (seeded at startup, NOT via public registration) ─
# Set ADMIN_EMAIL + ADMIN_PASSWORD to create the first admin account.
# Generate a strong password, e.g. with:  openssl rand -base64 18
ADMIN_NAME=Super Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kenya Power account lookup API (leave empty for development format-check)
KP_API_URL=

# ── Payment providers (leave empty to disable live payments) ─────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

AIRTEL_API_KEY=
AIRTEL_CALLBACK_URL=

BANK_ACCOUNT_NUMBER=
BANK_NAME=
