    ├── landlord.html                  # Landlord fleet portal
    ├── admin-dashboard.html           # Admin console
    ├── app.js                         # Shared API client + session/route guards
    ├── css/
    │   ├── portal.css                 # Design system for dashboards & auth
    │   └── landing.css                # Styles for the marketing page
    └── src/                           # Optional React prototype (dev only)
